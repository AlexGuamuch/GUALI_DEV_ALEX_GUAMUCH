<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>edu.umg.guali</groupId>
        <artifactId>codifica-con-guali</artifactId>
        <version>2.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>compilador-service</artifactId>
    <name>compilador-service</name>
    <description>Compila y ejecuta código Java con guali-dev.jar, aislado del resto del sistema.</description>

    <!-- guali-dev.jar (provisto por el catedrático) instalado en un repositorio Maven dentro del proyecto -->
    <repositories>
        <repository>
            <id>guali-local</id>
            <url>file://${project.basedir}/../../libs/maven-repo</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>edu.umg.guali</groupId>
            <artifactId>configuracion-local</artifactId>
        </dependency>
        <dependency>
            <groupId>edu.umg.guali</groupId>
            <artifactId>guali-dev</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- En Windows la consola no es UTF-8: los programas de prueba heredan esta opción.
                     En Docker la aplican los envoltorios de sandbox/java y sandbox/javac. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <JAVA_TOOL_OPTIONS>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</JAVA_TOOL_OPTIONS>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
