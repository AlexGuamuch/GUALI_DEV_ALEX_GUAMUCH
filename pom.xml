<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>edu.umg.guali</groupId>
    <artifactId>codifica-con-guali</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>Codifica con Guali</name>
    <description>Plataforma web para practicar Java con lecciones cortas (proyecto Desarrollo Web, UMG).</description>

    <modules>
        <module>services/seguridad-comun</module>
        <module>services/lecciones-service</module>
        <module>services/compilador-service</module>
        <module>services/admin-service</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <commonmark.version>0.31.0</commonmark.version>
        <owasp-sanitizer.version>20261011.1</owasp-sanitizer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>edu.umg.guali</groupId>
                <artifactId>seguridad-comun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>${owasp-sanitizer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
